# MedDiag configuration - copy to .env and adjust.
# Every variable is optional; the defaults shown here are what the service uses.

# --- server
MEDDIAG_HOST=127.0.0.1
MEDDIAG_PORT=8000
MEDDIAG_DEBUG=false

# --- security: when set, every /api/v1 route requires the X-API-Key header
# MEDDIAG_API_KEY=change-me

# --- limits
MEDDIAG_MAX_UPLOAD_MB=25

# --- compute: auto | cpu | cuda
MEDDIAG_DEVICE=auto

# --- explainable AI
MEDDIAG_XAI_ENABLED=true
MEDDIAG_XAI_MAX_FEATURES=8

# --- signal defaults
MEDDIAG_ECG_DEFAULT_SAMPLING_RATE=500
MEDDIAG_EEG_DEFAULT_SAMPLING_RATE=256

# --- retention
MEDDIAG_RETAIN_ANALYSES_DAYS=30
